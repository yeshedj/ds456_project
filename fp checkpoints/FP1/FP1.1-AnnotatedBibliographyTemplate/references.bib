@article{watanabe2025,
  title   = {Comparison of large language model with aphasia},
  author  = {Watanabe, Takamitsu and Inoue, Katsuma and Kuniyoshi, Yasuo and Nakajima, Kohei and Aihara, Kazuyuki},
  journal = {Advanced Science},
  volume  = {12},
  eid     = {2414016},
  year    = {2025},
  doi     = {10.1002/advs.202414016},
  note    = {The authors use energy landscape analysis to compare how signals move through several publicly available large language models (LLMs) with resting-state brain activity from people with different types of aphasia. They report that the LLMs' internal dynamics resemble those seen in receptive (Wernicke's) aphasia, and they suggest the parallel could inform both aphasia diagnosis and efforts to make LLMs more reliable. The authors stress that the finding is an analogy about dynamics, not a claim that chatbots have brain damage.}
}

@article{adikari2025,
  title   = {Reconstructing impaired language using generative {AI} for people with aphasia},
  author  = {Adikari, Achini and Alahakoon, Damminda and Pallewela, Nuwan and Pierce, John E. and Hernandez, Nelson J. and Rose, Miranda L.},
  journal = {Scientific Reports},
  volume  = {15},
  eid     = {40877},
  year    = {2025},
  doi     = {10.1038/s41598-025-24725-x},
  note    = {Adikari and colleagues build an assistive tool that uses a generative LLM to turn the fragmented or error-filled speech of people with aphasia into complete sentences. The model is customized through in-context few-shot prompting rather than retraining, and it is tested against different kinds of speech errors in more naturalistic conversation, reaching about 80 percent accuracy with GPT-4o. The paper is useful as an example of LLMs used for communication support rather than for assessment.}
}

@article{cong2024,
  title   = {Clinical efficacy of pre-trained large language models through the lens of aphasia},
  author  = {Cong, Yan and LaCroix, Arianna N. and Lee, Jiyeon},
  journal = {Scientific Reports},
  volume  = {14},
  eid     = {15573},
  year    = {2024},
  doi     = {10.1038/s41598-024-66576-y},
  note    = {Cong, LaCroix, and Lee ask whether surprisal, a measure of how unexpected a text is to a pre-trained LLM, can work as a clinical index of aphasia. Using AphasiaBank transcripts and five GPT-type models, they find that surprisals can detect the presence and different kinds of aphasia, improve subtyping when combined with existing language measures, and capture agrammatic deficits at the word and sentence level. The authors note that larger samples and more aphasia types are needed to confirm clinical efficacy.}
}

@article{cong2026,
  title   = {Evaluating the utility of large language models for detecting and simulating language dysfunction},
  author  = {Cong, Yan and LaCroix, Arianna N. and Lee, Jiyeon and Rajput, Nalin and Tumacder, Emily A.},
  journal = {Frontiers in Artificial Intelligence},
  volume  = {9},
  eid     = {1857106},
  year    = {2026},
  doi     = {10.3389/frai.2026.1857106},
  note    = {This study examines how well LLMs can both simulate and classify language dysfunction, with a focus on aphasia. The authors emphasize evaluation pipelines and approaches rather than new conceptual claims, and they conclude that LLMs show potential as tools for evaluating and generating data in the study of language dysfunction. It extends the same group's earlier work on LLM-based detection of aphasia.}
}

@article{allen2025,
  title   = {Harnessing {AI} for aphasia: A case report on {ChatGPT}'s role in supporting written expression},
  author  = {Allen, Avery K. and Brennan, Christine and Riseman, Christina and Kleiber, Holly and Hilger, Allison I.},
  journal = {Frontiers in Rehabilitation Sciences},
  volume  = {6},
  eid     = {1600145},
  year    = {2025},
  doi     = {10.3389/fresc.2025.1600145},
  note    = {This case report evaluates a ChatGPT-based writing intervention for one adult with fluent aphasia, aiming to improve the accuracy, complexity, and productivity of the person's written output. The authors conclude that AI tools can strengthen written communication and support participation in meaningful activities, especially for people with prior technology experience. Because it is a single case, it shows feasibility rather than effects that can be generalized.}
}

@article{manir2024,
  title   = {{LLM}-based text prediction and question answer models for aphasia speech},
  author  = {Manir, Shamiha Binta and Islam, K. M. Sajjadul and Madiraju, Praveen and Deshpande, Priya},
  journal = {IEEE Access},
  volume  = {12},
  pages   = {114670--114680},
  year    = {2024},
  doi     = {10.1109/ACCESS.2024.3443592},
  note    = {Manir and colleagues use BERT models to predict masked words and complete sentences in cleaned AphasiaBank transcripts, and they also apply BERT to question answering to support context comprehension. With no control data available, four raters judged the predictions manually, and the authors report strong inter-rater reliability and good contextual appropriateness and grammatical correctness. The work frames sentence prediction as a way to help caregivers and speech therapists.}
}

@article{landrigan2021,
  title   = {A data-driven approach to post-stroke aphasia classification and lesion-based prediction},
  author  = {Landrigan, Jon-Frederick and Zhang, Fengqing and Mirman, Daniel},
  journal = {Brain},
  volume  = {144},
  number  = {5},
  pages   = {1372--1383},
  year    = {2021},
  doi     = {10.1093/brain/awab010},
  note    = {The authors cluster people with post-stroke aphasia by their behavioral deficit profiles using community detection analysis and compare the clusters with traditional aphasia subtypes. Random forest classifiers trained on lesion profiles predicted cluster membership with 75 percent accuracy, versus 60 percent for the traditional fluent and non-fluent distinction. The study supports a data-driven alternative to traditional subtype classification in research and clinical settings.}
}

@inproceedings{gu2020,
  title     = {A machine learning approach for predicting post-stroke aphasia recovery: A pilot study},
  author    = {Gu, Yiwen and Bahrani, Murtadha and Billot, Anne and Lai, Sha and Braun, Emily J. and Varkanitsa, Maria and Bighetto, Julia and Rapp, Brenda and Parrish, Todd B. and Caplan, David and Thompson, Cynthia K. and Kiran, Swathi and Betke, Margrit},
  booktitle = {Proceedings of the 13th ACM International Conference on PErvasive Technologies Related to Assistive Environments (PETRA '20)},
  pages     = {1--9},
  year      = {2020},
  publisher = {Association for Computing Machinery},
  doi       = {10.1145/3389189.3389204},
  note      = {This pilot study builds a machine learning framework that takes a complex set of behavioral and brain features from people with post-stroke aphasia and uses them to classify and predict responsiveness to language therapy. The authors present it as a first step toward predicting individualized rehabilitation outcomes. It is early work from a research group whose later studies build directly on it.}
}

@article{hu2025,
  title   = {Aphasia severity prediction using a multi-modal machine learning approach},
  author  = {Hu, Xinyi and Varkanitsa, Maria and Kropp, Emerson and Betke, Margrit and Ishwar, Prakash and Kiran, Swathi},
  journal = {NeuroImage},
  volume  = {317},
  eid     = {121300},
  year    = {2025},
  doi     = {10.1016/j.neuroimage.2025.121300},
  note    = {Hu and colleagues compare support vector regression and random forest models for predicting aphasia severity (Western Aphasia Battery-Revised Aphasia Quotient) from structural MRI, resting-state fMRI, and diffusion tensor imaging. Multi-modal models outperformed single-modality models, which indicates that severity depends on more than lesion location and volume, and feature selection pointed to functional connectivity within and between hemispheres as especially important. The authors suggest the approach could inform personalized rehabilitation.}
}

@article{kristinsson2021,
  title   = {Machine learning-based multimodal prediction of language outcomes in chronic aphasia},
  author  = {Kristinsson, Sigfus and Zhang, Wanfang and Rorden, Chris and Newman-Norlund, Roger and Basilakos, Alexandra and Bonilha, Leonardo and Yourganov, Grigori and Xiao, Feifei and Hillis, Argye and Fridriksson, Julius},
  journal = {Human Brain Mapping},
  volume  = {42},
  number  = {6},
  pages   = {1682--1698},
  year    = {2021},
  doi     = {10.1002/hbm.25321},
  note    = {The authors use support vector regression to predict aphasia severity and specific language measures from task-based fMRI, fractional anisotropy, cerebral blood flow, and lesion load, with language measured by the Western Aphasia Battery. A model combining all modalities was the most accurate for every language measure (r = .53 to .67), which indicates that different imaging modalities carry complementary information about how brain damage translates into language function in chronic aphasia.}
}